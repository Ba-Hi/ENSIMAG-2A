ord <- qnorm(ppoints(n)) # Meilleure approximation des quantiles
abs <- x
plot(abs, ord, main="Graphe de probabilité normale", xlab="Valeurs observées", ylab="Quantiles théoriques")
reg <- lm(ord ~ abs)
lines(abs, fitted(reg), col='pink') # Ajout de la régression correctement
# Calcul des paramètres
sigma <- 1 / reg$coefficients[2]
mu <- -sigma * reg$coefficients[1]
# Affichage des résultats
sigma
mu
help("ppoints")
moins <- function(i) {
if (i == 1){
return (100)
} else {
return (i - 1)
}
}
plus <- function(i) {
if (i == 100){
return (1)
} else {
return (i + 1)
}
}
