}
somme <- sum(R)
proba_c <- R / somme
c_val <- sample(1:n, 1, prob = proba_c)
# 2. Tirage de theta1 et theta2 | y, c
s1 <- if (c_val > 1) sum(y[1:(c_val - 1)]) else 0
m1 <- c_val - 1
s2 <- sum(y[c_val:n])
m2 <- n - m1
theta1 <- rbeta(1, 1 + s1, 1 + m1 - s1)
